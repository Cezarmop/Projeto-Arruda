{
  "rewrites": [
    {
      "source": "/api/soap/v1/compras",
      "destination": "/api/soap-v1"
    },
    {
      "source": "/api/v1",
      "destination": "/api/v1"
    },
    {
      "source": "/api/v1/:caminho*",
      "destination": "/api/v1?caminho=:caminho*"
    }
  ],
  "headers": [
    {
      "source": "/contratos/(.*)\\.xsd",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ]
}
