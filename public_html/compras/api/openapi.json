{
 "openapi": "3.0.3",
 "info": {
  "title": "API REST do Controle de Compras (Projeto Arruda)",
  "version": "1.0.0",
  "description": "Substitui o socket da turma por HTTP. Os setores enviam XML ao Compras (POST) e buscam o que o Compras publica (GET). Toda rota protegida usa `Authorization: Bearer <chave>`; a chave identifica o setor."
 },
 "servers": [
  {
   "url": "/compras/api",
   "description": "Mesmo dominio da tela do Compras"
  }
 ],
 "tags": [
  {
   "name": "Geral"
  },
  {
   "name": "Entrada",
   "description": "Setores enviam ao Compras"
  },
  {
   "name": "Estoque busca",
   "description": "O que o Compras publica para o Estoque"
  },
  {
   "name": "Painel",
   "description": "Uso interno da tela do Compras"
  }
 ],
 "paths": {
  "/v1": {
   "get": {
    "tags": [
     "Geral"
    ],
    "summary": "Lista as rotas",
    "responses": {
     "200": {
      "description": "Indice."
     }
    }
   }
  },
  "/v1/saude": {
   "get": {
    "tags": [
     "Geral"
    ],
    "summary": "Estado da API e das integracoes",
    "responses": {
     "200": {
      "description": "Estado."
     }
    }
   }
  },
  "/v1/openapi.json": {
   "get": {
    "tags": [
     "Geral"
    ],
    "summary": "Este contrato",
    "responses": {
     "200": {
      "description": "OpenAPI 3."
     }
    }
   }
  },
  "/v1/mensagens": {
   "post": {
    "tags": [
     "Entrada"
    ],
    "summary": "Recebe qualquer XML suportado",
    "description": "O tipo e descoberto pela raiz e namespace: confirmacaoRecebimento, respostaDisponibilidade, estoque v2 (saldo), avisoPagamento, respostaPendencias. Contratos com XSD local sao validados. Quem envia: Estoque ou Financeiro.",
    "security": [
     {
      "chaveSetor": []
     }
    ],
    "requestBody": {
     "required": true,
     "description": "XML do contrato, UTF-8.",
     "content": {
      "application/xml": {
       "schema": {
        "type": "string"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Mensagem ja recebida antes (idempotente); nada mudou.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Recebida"
        }
       }
      }
     },
     "202": {
      "description": "Recebida; o Compras aplica na proxima leitura da caixa de entrada.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Recebida"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/Erro"
     },
     "401": {
      "$ref": "#/components/responses/Erro"
     },
     "403": {
      "$ref": "#/components/responses/Erro"
     },
     "413": {
      "$ref": "#/components/responses/Erro"
     },
     "415": {
      "$ref": "#/components/responses/Erro"
     },
     "422": {
      "$ref": "#/components/responses/Erro"
     }
    }
   }
  },
