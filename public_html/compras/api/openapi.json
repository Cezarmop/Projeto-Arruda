  "/v1/publicacoes": {
   "post": {
    "tags": [
     "Painel"
    ],
    "summary": "Publica XML para o Estoque buscar",
    "security": [
     {
      "chaveSetor": []
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "tipo",
         "xml"
        ],
        "properties": {
         "tipo": {
          "type": "string",
          "enum": [
           "recebimento",
           "previsao-entrega",
           "consulta-disponibilidade"
          ]
         },
         "xml": {
          "type": "string"
         },
         "referencia": {
          "type": "string",
          "maxLength": 100
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Ja publicado (mesmo XML).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Recebida"
        }
       }
      }
     },
     "201": {
      "description": "Publicado.",
