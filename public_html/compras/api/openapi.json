 "components": {
  "securitySchemes": {
   "chaveSetor": {
    "type": "http",
    "scheme": "bearer",
    "description": "Chave emitida pelo Compras para cada setor (config.php)."
   }
  },
  "responses": {
   "Erro": {
    "description": "Erro",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Erro"
      }
     }
    }
   }
  },
  "schemas": {
   "Erro": {
    "type": "object",
    "required": [
     "ok",
     "erro"
    ],
    "properties": {
     "ok": {
      "type": "boolean",
      "enum": [
       false
      ]
     },
     "erro": {
      "type": "string"
     },
     "detalhes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   },
   "Recebida": {
    "type": "object",
    "required": [
     "ok",
     "seq"
    ],
    "properties": {
     "ok": {
      "type": "boolean"
     },
     "seq": {
      "type": "integer"
     },
     "tipo": {
      "type": "string"
     },
     "duplicada": {
      "type": "boolean"
     },
     "mensagem": {
      "type": "string"
     }
    }
   },
   "ListaPublicacoes": {
    "type": "object",
    "properties": {
     "tipo": {
      "type": "string"
     },
     "desde": {
      "type": "integer"
     },
     "ultimo": {
      "type": "integer"
     },
     "itens": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "seq": {
         "type": "integer"
        },
        "referencia": {
         "type": "string",
         "nullable": true
        },
        "publicadoEm": {
         "type": "string",
         "format": "date-time"
        },
        "xml": {
         "type": "string"
        }
       }
      }
     }
    }
   },
   "CaixaEntrada": {
    "type": "object",
    "properties": {
     "desde": {
      "type": "integer"
     },
     "ultimo": {
      "type": "integer"
     },
     "itens": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "seq": {
         "type": "integer"
        },
        "tipo": {
         "type": "string",
         "enum": [
          "confirmacao-recebimento",
          "resposta-disponibilidade",
          "saldo-estoque",
          "aviso-pagamento",
          "resposta-pendencias"
         ]
        },
        "formato": {
         "type": "string",
         "enum": [
          "xml",
          "json"
         ]
        },
        "de": {
         "type": "string"
        },
        "referencia": {
         "type": "string",
         "nullable": true
        },
        "recebidoEm": {
         "type": "string",
         "format": "date-time"
        },
        "conteudo": {
         "type": "string"
        }
       }
      }
     },
     "financeiro": {
      "type": "object",
      "description": "Resultado da busca automatica de avisos no Finanweb."
     }
    }
   },
   "AvisoPagamento": {
    "type": "object",
    "required": [
     "id",
     "origem",
     "referencia",
     "situacao",
     "valor"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "dataAviso": {
      "type": "string",
      "format": "date"
     },
     "origem": {
      "type": "string"
     },
     "referencia": {
      "type": "string"
     },
     "cpf": {
      "type": "string",
      "nullable": true
     },
     "situacao": {
      "type": "string",
      "enum": [
       "PAGO",
       "CANCELADO"
      ]
     },
     "favorecido": {
      "type": "object",
      "properties": {
       "nome": {
        "type": "string"
       },
       "documento": {
        "type": "string",
        "nullable": true
       }
      }
     },
     "valor": {
      "type": "number",
      "minimum": 0
     },
     "dataPagamento": {
      "type": "string",
      "format": "date",
      "nullable": true
     },
     "geradoEm": {
      "type": "string",
      "format": "date-time"
     }
    }
   }
  }
 }
